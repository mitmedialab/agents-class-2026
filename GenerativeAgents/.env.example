# Copy this file to .env (same folder) and fill in your key. .env is git-ignored; never commit it.
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-lite-latest (Google's alias for the newest Flash-Lite): about
# 1.5 s per conversation. gemini-flash-latest thinks before answering: richer, but 25-50 s each.
# If the server says the model is unavailable, it lists the Flash models your key can use.
# GEMINI_MODEL=gemini-flash-lite-latest
