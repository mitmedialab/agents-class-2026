# Development-only example. Never commit real credentials or API keys.
DATABASE_URL=postgresql://class_agent:class_agent_dev@127.0.0.1:5432/class_agent
TEST_DATABASE_URL=postgresql://class_agent:class_agent_dev@127.0.0.1:5432/class_agent

# Used beginning in Phase 3. Leave blank in committed files.
MODEL_PROVIDER=openai
MODEL_ID=gpt-5.6-terra
AGENT_MAX_STEPS=10
OPENAI_API_KEY=
BRAVE_API_KEY=

# Lifetime limits for each seven-day anonymous session. Authenticated users are exempt.
# Set false only in local development; keep enabled in deployed environments.
ANONYMOUS_QUOTAS_ENABLED=true
ANONYMOUS_MAX_CONVERSATIONS=3
ANONYMOUS_MAX_AGENT_RUNS=10
ANONYMOUS_MAX_UPLOADS=5
ANONYMOUS_MAX_UPLOAD_BYTES=20971520

# Set false temporarily to skip mandatory-image and strict image-layout checks.
# Component schemas, resource authorization, and chart integrity remain enforced.
WORKSPACE_STRICT_VISUAL_POLICY=true

# Private server-side application submissions. Defaults to ./var/applicants.
APPLICANT_DATA_PATH=./var/applicants

# One validated JSON file per course assignment. Defaults to ./var/assignments.
ASSIGNMENT_DATA_PATH=./var/assignments

# Separate Course MCP process for ChatGPT. This must be the public HTTPS origin
# of the course website; the protected resource is this origin plus /mcp.
MCP_PUBLIC_BASE_URL=https://cognitive-agents.media.mit.edu
MCP_MESSAGING_ENABLED=false
# Exact comma-separated app-specific callbacks from Google Connected Console.
MCP_GEMINI_OAUTH_REDIRECT_URIS=
# Short deployment identifier included in privacy-light MCP tool-use aggregates.
MCP_RELEASE=dev
MCP_PORT=8001

# Role-scoped course resources under students/ and instructors/. Keep real data out of Git.
COURSE_DATA_PATH=./data

# Canonical private accepted/active/inactive roster. Publish role-scoped projections beneath
# COURSE_DATA_PATH before restart; startup rejects missing or stale projections.
COURSE_ROSTER_PATH=./var/roster/course-members.json

# Standard SKILL.md bundles plus the deterministic audience registry.
SKILLS_PATH=./skills

# Principal-scoped chat uploads expire after 24 hours.
UPLOAD_DATA_PATH=./var/uploads

# Local public knowledge written after an authorized staff PUBLISH reply.
PUBLISHED_FAQ_PATH=./var/course-knowledge/published-faq.json

# Isolated server-side browser. Twenty contexts support ten concurrent users with
# up to two panels each. Install Chromium or set the path to an existing executable.
BROWSER_ENABLED=true
BROWSER_MAX_SESSIONS=20
BROWSER_MAX_SESSIONS_PER_PRINCIPAL=2
BROWSER_SESSION_TTL_SECONDS=900
BROWSER_EXECUTABLE_PATH=

# Optional direct, read-only access to the private course repositories. Use a fine-grained
# token or GitHub App installation token limited to Contents, Metadata, Pull requests,
# Issues, Actions, and Pages read access for mitmedialab/agents2026-* repositories.
GITHUB_STUDENT_PROJECTS_ENABLED=false
GITHUB_TOKEN=
GITHUB_ORGANIZATION=mitmedialab
GITHUB_REPOSITORY_PREFIX=agents2026-
GITHUB_EXCLUDED_REPOSITORIES=agents2026-test
# Cache only the bounded project roster and deployed URLs; repository reads remain live.
GITHUB_ROSTER_CACHE_TTL_SECONDS=300

# Optional authenticated-student escalation through Gmail or Microsoft 365.
MAIL_ENABLED=false
# The API needs only MAIL_ENABLED. Put the remaining values in a separate protected
# worker environment file in production.
MAIL_PROVIDER=google_gmail
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
# Gmail only: an offline OAuth token authorized for gmail.send and gmail.readonly.
MAIL_REFRESH_TOKEN=
MAILBOX_ADDRESS=
MAIL_STAFF_RECIPIENT_ADDRESS=
# Comma-separated staff addresses allowed to answer. Active TA/instructor/admin account
# emails are also trusted automatically. Student and arbitrary senders are rejected.
MAIL_AUTHORIZED_REPLY_SENDERS=
MAIL_POLL_INTERVAL_SECONDS=60

# Optional. The web build defaults to the same-origin /api/v1 route.
VITE_API_BASE_URL=/api/v1

# Staff-maintained presentation history, read afresh for each selection.
SHOWCASE_HISTORY_PATH=var/student-showcase/history.json
