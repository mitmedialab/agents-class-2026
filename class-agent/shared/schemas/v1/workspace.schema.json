{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.media.mit.edu/schemas/v1/workspace.schema.json",
  "title": "Class Agent workspace contracts v1",
  "$defs": {
    "JsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/JsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      ]
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/JsonValue" }
    },
    "ComponentOperation": {
      "enum": ["open", "update", "focus", "close"]
    },
    "ComponentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "description",
        "props_schema",
        "supported_operations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "props_schema": { "$ref": "#/$defs/JsonObject" },
        "supported_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ComponentOperation" }
        },
        "default_size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "ComponentRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "components"],
      "properties": {
        "schema_version": { "const": 1 },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentManifest" }
        }
      }
    },
    "WorkspaceLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "WorkspacePanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component_id", "props", "state"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "component_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "resource_uri": { "type": "string", "minLength": 1, "maxLength": 500 },
        "props": { "$ref": "#/$defs/JsonObject" },
        "state": { "$ref": "#/$defs/JsonObject" },
        "layout": { "$ref": "#/$defs/WorkspaceLayout" }
      }
    },
    "WorkspaceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panels"],
      "properties": {
        "panels": {
          "type": "array",
          "items": { "$ref": "#/$defs/WorkspacePanel" }
        },
        "focused_panel_id": { "type": "string", "format": "uuid" }
      }
    },
    "DocumentHighlightAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_uri", "page", "quote"],
      "properties": {
        "resource_uri": { "type": "string", "minLength": 1, "maxLength": 500 },
        "page": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "prefix": { "type": "string", "maxLength": 500 },
        "suffix": { "type": "string", "maxLength": 500 }
      }
    },
    "OpenWorkspaceCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "panel"],
      "properties": {
        "type": { "const": "open" },
        "panel": { "$ref": "#/$defs/WorkspacePanel" }
      }
    },
    "UpdateWorkspaceCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "panel_id"],
      "anyOf": [
        { "required": ["props"] },
        { "required": ["state"] },
        { "required": ["title"] },
        { "required": ["resource_uri"] }
      ],
      "properties": {
        "type": { "const": "update" },
        "panel_id": { "type": "string", "format": "uuid" },
        "props": { "$ref": "#/$defs/JsonObject" },
        "state": { "$ref": "#/$defs/JsonObject" },
        "title": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 200 }
          ]
        },
        "resource_uri": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 500 }
          ]
        }
      }
    },
    "FocusWorkspaceCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "panel_id"],
      "properties": {
        "type": { "const": "focus" },
        "panel_id": { "type": "string", "format": "uuid" }
      }
    },
    "CloseWorkspaceCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "panel_id"],
      "properties": {
        "type": { "const": "close" },
        "panel_id": { "type": "string", "format": "uuid" }
      }
    },
    "WorkspaceCommand": {
      "oneOf": [
        { "$ref": "#/$defs/OpenWorkspaceCommand" },
        { "$ref": "#/$defs/UpdateWorkspaceCommand" },
        { "$ref": "#/$defs/FocusWorkspaceCommand" },
        { "$ref": "#/$defs/CloseWorkspaceCommand" }
      ]
    }
  }
}
