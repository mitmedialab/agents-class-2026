limit_req_zone $binary_remote_addr zone=class_agent_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=class_agent_model:10m rate=3r/m;
limit_conn_zone $binary_remote_addr zone=class_agent_connections:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 80;
    listen [::]:80;
    server_name cognitive-agents.media.mit.edu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name cognitive-agents.media.mit.edu;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/cognitive-agents.media.mit.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cognitive-agents.media.mit.edu/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    root /home/wazeer/agents-class-2026/class-agent/apps/web/dist;
    index index.html;

    location ~ ^/api/v1/(agent/run|conversations/[0-9a-fA-F-]+/run(/stream)?)$ {
        client_max_body_size 64k;
        limit_req zone=class_agent_model burst=2 nodelay;
        limit_conn class_agent_connections 3;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /api/ {
        client_max_body_size 11m;
        limit_req zone=class_agent_api burst=20 nodelay;
        limit_conn class_agent_connections 20;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
