[Unit]
Description=MIT Cognitive Agents grading preview API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=wazeer
Group=wazeer
WorkingDirectory=/home/wazeer/agents-class-2026/class-agent
EnvironmentFile=/home/wazeer/agents-class-2026/class-agent/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env GRADE_PREVIEW_USERNAME=test-student2 GRADE_PREVIEW_DATA_PATH=/home/wazeer/agents-class-2026/class-agent/var/grades/test-student2-preview.json GRADE_PREVIEW_ONLY=true BROWSER_ENABLED=false MAIL_ENABLED=false GITHUB_STUDENT_PROJECTS_ENABLED=false /home/wazeer/agents-class-2026/class-agent/.venv/bin/uvicorn course_server.api:create_app --factory --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/home/wazeer/agents-class-2026/class-agent/var/applicants
ReadWritePaths=/home/wazeer/agents-class-2026/class-agent/var/uploads
ReadWritePaths=/home/wazeer/agents-class-2026/class-agent/var/student-showcase/selections
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
